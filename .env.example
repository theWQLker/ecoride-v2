# Copier ce fichier vers .env et remplir les valeurs.
# .env n'est JAMAIS commité (voir .gitignore).

NODE_ENV=development
PORT=3000

# MySQL — depuis docker compose, l'hôte est le nom du service ("mysql").
# Depuis la machine locale (npm run dev), c'est "localhost".
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ecoride
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=ecoride
MYSQL_POOL_LIMIT=10

# Mot de passe root, utilisé uniquement par le conteneur MySQL.
MYSQL_ROOT_PASSWORD=changeme-root

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=ecoride
MONGO_TIMEOUT_MS=3000
