{
  "name": "ecoride-v2",
  "version": "0.1.0",
  "private": true,
  "description": "EcoRide V2 — plateforme de covoiturage (squelette)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:front",
    "build:server": "tsc -p tsconfig.json",
    "build:front": "node esbuild.config.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongodb": "^6.20.0",
    "mysql2": "^3.15.3",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
